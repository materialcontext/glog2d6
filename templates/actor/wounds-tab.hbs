{{!-- Wounds Tab --}}
<div class="tab" data-group="primary" data-tab="wounds">
    <div class="wounds-tab-content">

        {{!-- Header --}}
        <div class="wounds-header flex flex-between flex-center mb-10 p-10 section">
            <div class="wounds-info text-bold">
                Active Wounds: {{system.wounds.count}}
            </div>
            {{#if editMode}}
            <a class="btn btn-secondary p-6 text-small flex flex-center flex-gap-4 add-wound-btn"
                title="Roll a wound manually">
                <i class="fas fa-dice-d20"></i> Roll Wound
            </a>
            {{/if}}
        </div>

        {{!-- What the wounds are doing to you --}}
        {{#if (gt system.wounds.count 0)}}
        <div class="wound-effects section mb-10">
            <h4 class="wound-effects-title">Current Effects</h4>

            {{#each system.wounds.effects.statReductions as |penalty stat|}}
            {{#if penalty}}
            <div class="wound-effect">
                <i class="fas fa-arrow-down"></i>
                <span>{{upperCase stat}} reduced by {{penalty}}</span>
            </div>
            {{/if}}
            {{/each}}

            {{#if system.wounds.effects.movementReduction}}
            <div class="wound-effect">
                <i class="fas fa-walking"></i>
                <span>Movement reduced to {{system.wounds.effects.movementReduction}}'</span>
            </div>
            {{/if}}

            {{#if system.wounds.effects.noHealing}}
            <div class="wound-effect">
                <i class="fas fa-heart-broken"></i>
                <span>Cannot regain hit points</span>
            </div>
            {{/if}}

            {{#if system.wounds.effects.extendedHealing}}
            <div class="wound-effect">
                <i class="fas fa-hourglass-half"></i>
                <span>Healing takes longer than usual</span>
            </div>
            {{/if}}

            {{#if system.wounds.effects.sleepDisruption}}
            <div class="wound-effect">
                <i class="fas fa-moon"></i>
                <span>Sleep is worth {{system.wounds.effects.sleepDisruption}} of normal</span>
            </div>
            {{/if}}

            {{#if (gt system.wounds.effects.attackPenalty 0)}}
            <div class="wound-effect">
                <i class="fas fa-khanda"></i>
                <span>Attack penalty &minus;{{system.wounds.effects.attackPenalty}}</span>
            </div>
            {{/if}}

            {{#if (gt system.wounds.effects.defensePenalty 0)}}
            <div class="wound-effect">
                <i class="fas fa-shield-halved"></i>
                <span>Defense penalty &minus;{{system.wounds.effects.defensePenalty}}</span>
            </div>
            {{/if}}

            {{#if (gt system.wounds.effects.reactionPenalty 0)}}
            <div class="wound-effect">
                <i class="fas fa-comments"></i>
                <span>Reaction penalty &minus;{{system.wounds.effects.reactionPenalty}}</span>
            </div>
            {{/if}}

            {{#each system.wounds.effects.combatEffects as |effect|}}
            <div class="wound-effect wound-effect-grave">
                <i class="fas fa-skull"></i>
                <span>{{combatEffectLabel effect}}</span>
            </div>
            {{/each}}

            {{#if system.wounds.effects.deathOnFailure}}
            <div class="wound-effect wound-effect-grave">
                <i class="fas fa-skull-crossbones"></i>
                <span>A failed trauma save kills you</span>
            </div>
            {{/if}}
        </div>
        {{/if}}

        {{!-- The wounds themselves --}}
        <div class="wounds-list flex flex-col flex-gap-8">
            {{#each wounds as |wound|}}
            <div class="wound-card section wound-state-{{wound.state}}" data-wound-id="{{wound.id}}">

                <div class="wound-card-head">
                    <div class="wound-title">
                        <span class="wound-name">{{wound.name}}</span>
                        {{#if wound.bodyPart}}
                        <span class="wound-part">{{wound.bodyPart}}</span>
                        {{/if}}
                    </div>
                    <span class="wound-state">{{woundStateLabel wound.state}}</span>
                </div>

                <div class="wound-meta">
                    {{#if wound.severity}}<span>Severity {{wound.severity}}</span>{{/if}}
                    <span>{{wound.damage}} damage</span>
                    {{#if wound.dateAcquired}}<span>{{formatDate wound.dateAcquired}}</span>{{/if}}
                </div>

                <div class="wound-description">{{wound.description}}</div>

                {{#if wound.maimedResult}}
                <div class="wound-note"><strong>Maimed:</strong> {{wound.maimedResult}}</div>
                {{/if}}

                {{#if wound.effects.rerollStat}}
                <div class="wound-note wound-note-danger">
                    <strong>Reroll your {{upperCase wound.effects.rerollStat}}.</strong>
                </div>
                {{/if}}

                <div class="wound-recovery-row">
                    <span class="wound-requirement">
                        <i class="fas fa-notes-medical"></i> {{wound.removal.reason}}
                    </span>
                    {{#if ../editMode}}
                    <span class="wound-actions">
                        {{#if wound.nextState}}
                        <a class="btn btn-secondary p-4 text-small advance-wound-btn" data-wound-id="{{wound.id}}"
                            title="Mark as {{wound.nextState}}">
                            <i class="fas fa-notes-medical"></i> {{woundStateLabel wound.nextState}}
                        </a>
                        {{/if}}
                        <a class="btn {{#if wound.removal.allowed}}btn-success{{else}}btn-secondary{{/if}} p-4 text-small remove-wound-btn"
                            data-wound-id="{{wound.id}}" title="{{wound.removal.reason}}">
                            <i class="fas fa-check"></i>
                        </a>
                    </span>
                    {{/if}}
                </div>
            </div>
            {{else}}
            <div class="empty-section text-center p-10 section">
                <div class="empty-icon text-muted mb-10">
                    <i class="fas fa-heart-pulse" style="font-size: 32px;"></i>
                </div>
                <p class="text-muted mb-8">No wounds currently.</p>
                <p class="text-small text-muted">Taking damage at 0 HP calls for a Trauma Save.</p>
            </div>
            {{/each}}
        </div>
    </div>
</div>
