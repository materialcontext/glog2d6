<form class="{{cssClass}} {{actor.type}}" autocomplete="off">
    <header class="flex flex-center flex-gap-8 p-10 section mb-10">
    <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"
        height="64" width="64" />
    <div class="header-fields w-full">
        <h1 class="charname">
            <input name="name" type="text" value="{{item.name}}" placeholder="Feature Name"
                class="input text-bold w-full" />
        </h1>
    </div>
</header>

<section class="sheet-body">

    <div class="feature-properties section p-10 mt-15">
        <h3>Properties</h3>
        <div class="grid-2 flex-gap-8 mt-8">
            <div class="form-group flex flex-col flex-gap-2">
                <label for="system.classSource" class="text-small text-bold text-upper text-muted">Class Source</label>
                <select name="system.classSource" class="input">
                    {{selectOptions classSources selected=system.classSource}}
                </select>
            </div>

            <div class="form-group flex flex-col flex-gap-2">
                <label for="system.template" class="text-small text-bold text-upper text-muted">Template</label>
                <select name="system.template" class="input">
                    {{selectOptions featureTemplates selected=system.template}}
                </select>
            </div>

            <div class="form-group flex flex-col flex-gap-2">
                <label for="system.level" class="text-small text-bold text-upper text-muted">Required Level</label>
                <input type="number" name="system.level" value="{{system.level}}" min="1" max="20"
                    class="input text-center" />
            </div>

            <div class="form-group flex flex-col flex-gap-2">
                <label for="system.active" class="text-small text-bold text-upper text-muted">Status</label>
                <label class="flex flex-center flex-gap-4">
                    <input type="checkbox" name="system.active" {{#if system.active}}checked{{/if}} class="clickable" />
                    <span class="text-small">Active</span>
                </label>
            </div>
        </div>
    </div>

    {{#if isReputationFeature}}
    <div class="form-group flex flex-col flex-gap-2 mt-15">
        <label for="system.reputationType" class="text-small text-bold text-upper text-muted">Reputation Type</label>
        <select name="system.reputationType" class="input">
            {{selectOptions reputationTypes selected=system.reputationType blank="Select a reputation..."}}
        </select>
    </div>
    {{/if}}

    <div class="form-group flex flex-col flex-gap-2 mt-15">
        <label for="system.description" class="text-small text-bold text-upper text-muted">Description</label>
        <textarea name="system.description" rows="12" class="input">{{system.description}}</textarea>
    </div>

</section>
</from>
