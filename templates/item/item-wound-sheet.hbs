{{!-- A wound, as a document. Authored by a GM for a table, or written by the
      trauma system when someone takes one. --}}
<div class="sheet-content" data-application-part="body">
    <header class="flex flex-gap-8 flex-center mb-10">
        <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
        <h1 class="charname">
            <input name="name" type="text" value="{{item.name}}" placeholder="Wound" class="input" />
        </h1>
    </header>

    <section class="sheet-body">
        <div class="grid-3">
            <div class="form-group">
                <label for="system.state" class="text-small text-bold text-upper text-muted">Recovery</label>
                <select name="system.state" class="input">
                    {{selectOptions woundStates selected=system.state}}
                </select>
            </div>

            <div class="form-group">
                <label for="system.bodyPart" class="text-small text-bold text-upper text-muted">Body Part</label>
                <select name="system.bodyPart" class="input">
                    <option value="">Unspecified</option>
                    {{selectOptions bodyParts selected=system.bodyPart}}
                </select>
            </div>

            <div class="form-group">
                <label for="system.severity" class="text-small text-bold text-upper text-muted">Severity</label>
                <input name="system.severity" type="number" value="{{system.severity}}" min="0"
                    class="input text-center" />
            </div>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label for="system.typeId" class="text-small text-bold text-upper text-muted">Table Id</label>
                <input name="system.typeId" type="text" value="{{system.typeId}}" placeholder="e.g. hobbled"
                    class="input" />
            </div>

            <div class="form-group">
                <label for="system.damage" class="text-small text-bold text-upper text-muted">Excess Damage</label>
                <input name="system.damage" type="number" value="{{system.damage}}" min="0"
                    class="input text-center" />
            </div>
        </div>

        <h3>What It Does</h3>
        <div class="form-group">
            <textarea name="system.description" rows="5" class="input"
                placeholder="What this wound does to you.">{{system.description}}</textarea>
        </div>

        <div class="form-group">
            <label for="system.maimedResult" class="text-small text-bold text-upper text-muted">Maimed Result</label>
            <input name="system.maimedResult" type="text" value="{{system.maimedResult}}"
                placeholder="Only for wounds that maim" class="input" />
        </div>
    </section>
</div>
